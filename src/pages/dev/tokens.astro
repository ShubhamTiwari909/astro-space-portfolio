---
/**
 * Token + primitive reference (§Phase 1 task 13). This is the visual
 * regression baseline for every later phase: if a token changes, it shows
 * up here first.
 *
 * Excluded from the sitemap (astro.config.mjs filter) and marked noindex.
 * Phase 8 removes it from the production build entirely.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Chip from '../../components/ui/Chip.astro';
import DataList from '../../components/ui/DataList.astro';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import Icon, { type IconName } from '../../components/ui/Icon.astro';
import MetricBlock from '../../components/ui/MetricBlock.astro';
import Panel from '../../components/ui/Panel.astro';
import StatusDot from '../../components/ui/StatusDot.astro';
import { BANDS } from '../../lib/bands';

const surfaces = ['void', 'surface-0', 'surface-1', 'surface-2'];
const inks = ['ink-hi', 'ink-mid', 'ink-low'];

/** Distinct bands — Ion Cyan serves both First Light and Uplink (§3.3). */
const uniqueBands = BANDS.filter(
	(b, i) => BANDS.findIndex((o) => o.hex === b.hex) === i,
);

const typeScale = [
	['display-xl', 'Hi, I&rsquo;m Shubham'],
	['display-l', 'Catalogued Worlds'],
	['display-m', 'Headless CMS & delivery'],
	['display-s', 'Sub-heading'],
	['body-l', 'Lede paragraph at body-l.'],
	['body', 'Body copy at the base size.'],
	['data', 'DATA READOUT 14× 2025'],
	['label', 'EYEBROW LABEL'],
] as const;

const icons: IconName[] = [
	'arrow-up-right', 'arrow-right', 'arrow-down', 'copy', 'check', 'mail',
	'home', 'atlas', 'trajectory', 'worlds', 'instruments', 'transmissions',
	'more', 'github', 'linkedin', 'devto', 'instagram',
];

const sampleClass: Record<string, string> = {
	'display-xl': 'font-display text-display-xl',
	'display-l': 'font-display text-display-l',
	'display-m': 'font-display text-display-m',
	'display-s': 'font-display text-display-s',
	'body-l': 'text-body-l text-ink-mid',
	body: 'text-body text-ink-mid',
	data: 'font-mono text-data tracking-[0.04em]',
	label: 'font-mono text-label tracking-[0.14em] text-ink-low',
};

const radii = ['chip', 'card', 'panel', 'pill'];
const glows = ['glow-1', 'glow-2', 'glow-3'];
---

<BaseLayout
	title="Design tokens · DEEP FIELD"
	description="Internal token and primitive reference."
	backdrop={false}
	indexable={false}
>
	<div class="relative z-(--z-content) mx-auto max-w-content px-(--gutter) pt-[calc(var(--nav-h)+3rem)] pb-24">
		<h1 class="text-display-l">Design tokens &amp; primitives</h1>
		<p class="text-data text-ink-low">
			Internal reference. Master plan §17–§18. Every value below is a token —
			no literals.
		</p>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Colour — surfaces</h2>
		<div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] gap-4">
			{surfaces.map((name) => (
				<div class="">
					<div class="mb-1.5 grid h-16 place-items-center rounded-card border border-hairline" style={`background-color: var(--color-${name})`}></div>
					<code class="font-mono text-[0.6875rem] text-ink-low">--color-{name}</code>
				</div>
			))}
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Colour — ink</h2>
		<div class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] gap-4">
			{inks.map((name) => (
				<div class="">
					<div class="mb-1.5 grid h-16 place-items-center rounded-card border border-hairline bg-surface-0 font-display text-2xl" style={`color: var(--color-${name})`}>Aa</div>
					<code class="font-mono text-[0.6875rem] text-ink-low">--color-{name}</code>
				</div>
			))}
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Colour — the eight spectral bands</h2>
		<p class="text-data text-ink-low">
			§3.3. One band per section; the hue travels with the visitor and drives
			both DOM accents and (from Phase 4) the scene's lighting. Every band
			must clear 4.5:1 on <code class="font-mono text-[0.6875rem] text-ink-low">--color-void</code> — which is why they are
			all light, high-value hues.
		</p>
		<div class="grid grid-cols-[repeat(auto-fill,minmax(13rem,1fr))] gap-5">
			{uniqueBands.map((band) => (
				<div class="grid gap-1 rounded-card border border-hairline bg-surface-0 p-3.5" style={`--b: ${band.hex}`}>
					<div class="h-12 rounded-chip bg-(--b) shadow-[0_0_24px_-6px_var(--b)]"></div>
					<p class="mt-1.5 mb-0 text-data text-ink-hi">{band.name}</p>
					<code class="font-mono text-[0.6875rem] text-ink-low">{band.hex}</code>
					<p class="m-0 text-[0.625rem] leading-snug text-ink-low">{band.source}</p>
					<p class:list={["mt-1 mb-0 font-mono text-[0.625rem] tracking-[0.04em]", band.contrastOnVoid >= 4.5 ? "text-(color:--b)" : "text-danger"]}>
						{band.contrastOnVoid.toFixed(1)}:1 on void
					</p>
					<p class="mt-1 mb-0 text-data text-(color:--b)">Link text at this band</p>
				</div>
			))}
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Band mechanism</h2>
		<p class="text-data text-ink-low">
			Every accent resolves through <code class="font-mono text-[0.6875rem] text-ink-low">--band</code>, so one write
			re-tints the page. Below is the live value on this page.
		</p>
		<div class="flex flex-wrap items-center gap-4">
			<div class="">
				<div class="mb-1.5 grid h-16 place-items-center rounded-card border border-hairline" style="background-color: var(--band)"></div>
				<code class="font-mono text-[0.6875rem] text-ink-low">--band (live)</code>
			</div>
			<div class="">
				<div class="mb-1.5 grid h-16 place-items-center rounded-card border border-hairline" style="background-color: var(--color-accent)"></div>
				<code class="font-mono text-[0.6875rem] text-ink-low">--color-accent</code>
			</div>
			<div class="">
				<div class="mb-1.5 grid h-16 place-items-center rounded-card border border-hairline" style="background-color: var(--color-accent-dim)"></div>
				<code class="font-mono text-[0.6875rem] text-ink-low">--color-accent-dim</code>
			</div>
			<div class="">
				<div class="mb-1.5 grid h-16 place-items-center rounded-card border border-hairline" style="background-color: var(--color-danger)"></div>
				<code class="font-mono text-[0.6875rem] text-ink-low">--color-danger</code>
			</div>
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Hairlines</h2>
		<div class="grid gap-3">
			<div class="border-t" style="border-color: var(--color-hairline)"></div>
			<code class="font-mono text-[0.6875rem] text-ink-low">--color-hairline</code>
			<div class="border-t" style="border-color: var(--color-hairline-hi)"></div>
			<code class="font-mono text-[0.6875rem] text-ink-low">--color-hairline-hi</code>
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Type scale</h2>
		<div class="grid gap-3">
			{typeScale.map(([token, sample]) => (
				<div class="grid gap-1 border-b border-hairline py-2">
					<code class="font-mono text-[0.6875rem] text-ink-low">--text-{token}</code>
					<p class={`m-0 text-ink-hi ${sampleClass[token]}`} set:html={sample} />
				</div>
			))}
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Families</h2>
		<div class="grid gap-3">
			<p style="font-family: var(--font-display); font-size: var(--text-display-m)">
				Instrument Serif — display
			</p>
			<p style="font-family: var(--font-body); font-size: var(--text-body-l)">
				Inter — body copy
			</p>
			<p style="font-family: var(--font-mono); font-size: var(--text-data)">
				JetBrains Mono — DATA 0123456789
			</p>
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Buttons — all six states</h2>
		<div class="flex flex-wrap items-center gap-4">
			<Button variant="primary">Primary</Button>
			<Button variant="secondary">Secondary</Button>
			<Button variant="ghost">Ghost</Button>
			<Button variant="primary" icon="arrow-right">With icon</Button>
			<Button variant="primary" disabled>Disabled</Button>
			<Button variant="primary" data-loading>Loading</Button>
		</div>
		<p class="text-data text-ink-low">
			Hover and focus-visible states are interactive — tab through the row.
		</p>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Panels</h2>
		<div class="flex flex-wrap items-stretch gap-4">
			<Panel variant="subtle"><p class="m-0 px-10 py-8 font-mono text-label tracking-[0.14em] text-ink-mid uppercase">subtle ticks</p></Panel>
			<Panel variant="standard"><p class="m-0 px-10 py-8 font-mono text-label tracking-[0.14em] text-ink-mid uppercase">standard ticks</p></Panel>
			<Panel variant="strong"><p class="m-0 px-10 py-8 font-mono text-label tracking-[0.14em] text-ink-mid uppercase">strong ticks</p></Panel>
			<Panel ticks={false}><p class="m-0 px-10 py-8 font-mono text-label tracking-[0.14em] text-ink-mid uppercase">no ticks</p></Panel>
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Chips</h2>
		<div class="flex flex-wrap items-center gap-4">
			<Chip>Next.js</Chip>
			<Chip>Tailwind CSS</Chip>
			<Chip>MongoDB</Chip>
			<Chip>Playwright</Chip>
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Status</h2>
		<div class="flex flex-wrap items-center gap-4">
			<StatusDot status="LIVE" />
			<StatusDot status="ARCHIVED" />
			<StatusDot status="PRIVATE" />
			<StatusDot status="OPEN" label="Open to roles" />
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Metric block</h2>
		<MetricBlock
			value="14×"
			label="faster page delivery"
			basis="From 2 pages per 14-day sprint to 2 pages per day"
		/>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Data list</h2>
		<Panel variant="standard" class="max-w-panel p-6">
			<DataList
				items={[
					{ label: 'Location', value: 'India' },
					{ label: 'Timezone', value: 'Asia/Kolkata · UTC+5:30' },
					{ label: 'Experience', value: '4 years' },
				]}
			/>
		</Panel>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Links</h2>
		<p>
			An <ExternalLink href="https://dev.to/shubhamtiwari909">external link</ExternalLink>
			carries an arrow and a hidden new-tab warning.
		</p>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Icons ({icons.length})</h2>
		<div class="grid grid-cols-[repeat(auto-fill,minmax(7rem,1fr))] gap-4">
			{icons.map((name) => (
				<div class="grid place-items-center gap-1.5 rounded-card border border-hairline px-2 py-4 text-center text-accent">
					<Icon name={name} size={24} />
					<code class="font-mono text-[0.6875rem] text-ink-low">{name}</code>
				</div>
			))}
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Radius</h2>
		<div class="flex flex-wrap items-center gap-4">
			{radii.map((r) => (
				<div class="grid h-16 w-24 place-items-center border border-hairline bg-surface-1" style={`border-radius: var(--radius-${r})`}>
					<code class="font-mono text-[0.6875rem] text-ink-low">{r}</code>
				</div>
			))}
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Glow</h2>
		<div class="flex flex-wrap items-center gap-4">
			{glows.map((g) => (
				<div class="grid h-16 w-24 place-items-center rounded-card border border-hairline bg-surface-1" style={`box-shadow: var(--shadow-${g})`}>
					<code class="font-mono text-[0.6875rem] text-ink-low">{g}</code>
				</div>
			))}
		</div>

		<h2 class="mt-12 mb-4 border-b border-hairline pb-2 text-display-s">Easing &amp; duration</h2>
		<DataList
			items={[
				{ label: 'instant', value: '120ms' },
				{ label: 'fast', value: '200ms — L2 interaction' },
				{ label: 'base', value: '320ms — rail, transitions' },
				{ label: 'slow', value: '560ms — L3 entrances' },
				{ label: 'cinematic', value: '900ms — L4 storytelling' },
				{ label: 'ambient', value: '24s — L1 nebula drift' },
				{ label: 'out-expo', value: 'cubic-bezier(0.16, 1, 0.3, 1)' },
				{ label: 'ui', value: 'cubic-bezier(0.4, 0, 0.2, 1)' },
			]}
		/>
	</div>
</BaseLayout>

