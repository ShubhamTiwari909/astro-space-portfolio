---
/**
 * Lost signal (§8.3). No cleverness that costs a visitor their next click:
 * three real links, zero JS.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
	title="Signal lost · Shubham Tiwari"
	description="That coordinate isn't in the catalog."
	indexable={false}
>
	<div
		class="relative z-[var(--z-content)] mx-auto max-w-panel px-[var(--gutter)] py-[calc(var(--section-y)+var(--nav-h))]"
	>
		<p class="font-mono text-label tracking-[0.14em] text-ink-low uppercase">
			Signal lost · 404
		</p>
		<h1 class="mt-4 mb-8 text-display-l">
			This coordinate isn't in the catalog.
		</h1>
		<div class="flex flex-wrap gap-3">
			<Button variant="primary" href="/" icon="arrow-right">Survey</Button>
			<Button variant="secondary" href="/#worlds">Worlds</Button>
			<Button variant="secondary" href="/#uplink">Uplink</Button>
		</div>
	</div>
</BaseLayout>
