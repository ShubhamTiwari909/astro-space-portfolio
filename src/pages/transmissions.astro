---
/**
 * Full writing index — master plan §5, §8.2. Excerpt-only, links out to
 * dev.to (§27.3). This route deliberately does not mount the scene in
 * Phase 4: it is a reading route and keeps the lighter budgets (§26.2).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Transmissions from '../components/transmissions/Transmissions.astro';
import Button from '../components/ui/Button.astro';

const articles = await getCollection('articles');
---

<BaseLayout
	title="Writing · Shubham Tiwari"
	description="Articles on frontend platforms, Next.js, Tailwind, testing and performance — published on dev.to."
>
	<Section
		id="transmissions"
		codename="Transmissions"
		readout={`${articles.length} signals`}
		title="Writing"
		lede="Everything published so far. Full posts live on dev.to."
	>
		<Transmissions articles={articles} />

		<div class="mt-10 flex flex-wrap gap-3">
			<Button variant="secondary" href="/" icon="arrow-right">
				Back to the survey
			</Button>
			<Button
				variant="ghost"
				href="https://dev.to/shubhamtiwari909"
				icon="arrow-up-right"
				external
			>
				dev.to profile
			</Button>
		</div>
	</Section>
</BaseLayout>
