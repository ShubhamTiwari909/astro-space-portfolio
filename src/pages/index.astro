---
/**
 * The survey — master plan §5.
 *
 * Phase 3 fills every section with real content. This is the shippable
 * milestone: if Phases 4+ never happened, this would still be a complete
 * portfolio (§31).
 *
 * Anchor ids are frozen — they are a public API (§23).
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/hero/Hero.astro';
import ScrollHint from '../components/hero/ScrollHint.astro';
import ObserversLog from '../components/about/ObserversLog.astro';
import Atlas from '../components/atlas/Atlas.astro';
import Trajectory from '../components/trajectory/Trajectory.astro';
import WorldsSection from '../components/worlds/WorldsSection.astro';
import InstrumentTeaser from '../components/instruments/InstrumentTeaser.astro';
import Transmissions from '../components/transmissions/Transmissions.astro';
import Uplink from '../components/uplink/Uplink.astro';

const profile = await getEntry('profile', 'shubham-tiwari');
if (!profile) throw new Error('profile entry missing');

const [skills, projects, articles, instruments, experience] = await Promise.all([
	getCollection('skills'),
	getCollection('projects'),
	getCollection('articles'),
	getCollection('instruments'),
	getCollection('experience'),
]);

const constellations = new Set(skills.map((s) => s.data.constellation));
const burnEvents = experience.reduce(
	(sum, entry) => sum + entry.data.achievements.length,
	0,
);
const LATEST = 6;
---

<BaseLayout
	title={`${profile.data.name} — ${profile.data.role}`}
	description={profile.data.lede}
	rail
>
	<Hero
		profile={profile.data}
		skillCount={skills.length}
		worldCount={projects.length}
	>
		<ScrollHint slot="hint" />
	</Hero>

	<Section
		id="log"
		codename="Observer's Log"
		readout={`${profile.data.yearsExperience} years · ${profile.data.location}`}
		title="About"
	>
		<ObserversLog profile={profile.data} />
	</Section>

	<Section
		id="atlas"
		codename="The Atlas"
		readout={`${skills.length} entries · ${constellations.size} constellations`}
		title="Skills"
		lede="Magnitude encodes depth of experience, not preference. The lines are real dependencies — React to TypeScript, Payload to MongoDB, Next.js out to Vercel."
	>
		<Atlas skills={skills} />
	</Section>

	<Section
		id="trajectory"
		codename="Trajectory"
		readout={`${profile.data.yearsExperience} years · ${burnEvents} burn events`}
		title="Experience"
		lede="Each burn is a moment where deliberate effort changed the vehicle's course."
	>
		<Trajectory positions={experience} />
	</Section>

	<Section
		id="worlds"
		codename="Catalogued Worlds"
		readout={`${projects.length} catalogued`}
		title="Projects"
	>
		<WorldsSection projects={projects} />
	</Section>

	<Section
		id="instruments"
		codename="Instrument Bay"
		readout={`${instruments.length} instruments`}
		title="What I Build"
		lede="The tools and systems behind the products, rather than the products themselves."
	>
		<InstrumentTeaser instruments={instruments} />
	</Section>

	<Section
		id="transmissions"
		codename="Transmissions"
		readout={`${Math.min(LATEST, articles.length)} of ${articles.length}`}
		title="Writing"
	>
		<Transmissions
			articles={articles}
			limit={LATEST}
			moreHref="/transmissions"
			moreLabel="All writing"
		/>
	</Section>

	<Section
		id="uplink"
		codename="Uplink"
		readout={`${profile.data.timezone} · ${profile.data.availability}`}
		title="Contact"
	>
		<Uplink profile={profile.data} />
	</Section>
</BaseLayout>
