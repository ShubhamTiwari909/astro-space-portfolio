---
/**
 * The survey. Phase 2 delivers the hero and the eight anchor shells with
 * their real codenames, titles and readouts; content lands in Phase 3, the
 * WebGL spine in Phase 4.
 *
 * Anchor ids are frozen from here on — they are a public API (§23).
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/hero/Hero.astro';
import ScrollHint from '../components/hero/ScrollHint.astro';

const profile = await getEntry('profile', 'shubham-tiwari');
if (!profile) throw new Error('profile entry missing');

const [skills, projects, articles, instruments, experience] = await Promise.all([
	getCollection('skills'),
	getCollection('projects'),
	getCollection('articles'),
	getCollection('instruments'),
	getCollection('experience'),
]);

const constellations = new Set(skills.map((s) => s.data.constellation));
const burnEvents = experience.reduce(
	(sum, entry) => sum + entry.data.achievements.length,
	0,
);
---

<BaseLayout
	title={`${profile.data.name} — ${profile.data.role}`}
	description={profile.data.lede}
	rail
>
	<Hero
		profile={profile.data}
		skillCount={skills.length}
		worldCount={projects.length}
	>
		<ScrollHint slot="hint" />
	</Hero>

	<Section
		id="log"
		codename="Observer's Log"
		readout={`${profile.data.yearsExperience} years · ${profile.data.location}`}
		title="About"
	>
		<p class="rounded-card border border-dashed border-hairline p-8 font-mono text-data text-ink-low">Observer's Log — Phase 3.</p>
	</Section>

	<Section
		id="atlas"
		codename="The Atlas"
		readout={`${skills.length} entries · ${constellations.size} constellations`}
		title="Skills"
	>
		<p class="rounded-card border border-dashed border-hairline p-8 font-mono text-data text-ink-low">Constellation map and skill list — Phase 3.</p>
	</Section>

	<Section
		id="trajectory"
		codename="Trajectory"
		readout={`${profile.data.yearsExperience} years · ${burnEvents} burn events`}
		title="Experience"
	>
		<p class="rounded-card border border-dashed border-hairline p-8 font-mono text-data text-ink-low">Trajectory spine — Phase 3.</p>
	</Section>

	<Section
		id="worlds"
		codename="Catalogued Worlds"
		readout={`${projects.length} catalogued`}
		title="Projects"
	>
		<p class="rounded-card border border-dashed border-hairline p-8 font-mono text-data text-ink-low">World records — Phase 3. Planets — Phase 4b.</p>
	</Section>

	<Section
		id="instruments"
		codename="Instrument Bay"
		readout={`${instruments.length} instruments`}
		title="What I Build"
	>
		<p class="rounded-card border border-dashed border-hairline p-8 font-mono text-data text-ink-low">Instrument teaser — Phase 3.</p>
	</Section>

	<Section
		id="transmissions"
		codename="Transmissions"
		readout={`${articles.length} latest`}
		title="Writing"
	>
		<p class="rounded-card border border-dashed border-hairline p-8 font-mono text-data text-ink-low">Transmission list — Phase 3.</p>
	</Section>

	<Section
		id="uplink"
		codename="Uplink"
		readout={`${profile.data.timezone} · ${profile.data.availability}`}
		title="Contact"
	>
		<p class="rounded-card border border-dashed border-hairline p-8 font-mono text-data text-ink-low">Uplink panel — Phase 3.</p>
	</Section>
</BaseLayout>

