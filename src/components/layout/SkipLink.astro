---
/** First focusable element on every page (§7.4). Visible on focus only. */
---

<a href="#main" class="skip">Skip to content</a>

<style>
	.skip {
		position: absolute;
		top: 0;
		left: 50%;
		translate: -50% -120%;
		z-index: var(--z-skip);
		padding: 0.75rem 1.25rem;
		background-color: var(--color-surface-2);
		border: 1px solid var(--color-ion);
		border-radius: 0 0 var(--radius-card) var(--radius-card);
		color: var(--color-ion);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		transition: translate var(--duration-fast) var(--ease-ui);
	}

	.skip:focus-visible {
		translate: -50% 0;
	}
</style>
