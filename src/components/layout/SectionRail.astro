---
/**
 * The declination rail — master plan §7.2.
 *
 * Additive only: this renders a complete, working anchor list, and the
 * script below adds the active state and the progress fill. Delete its JS
 * and navigation still works.
 *
 * ── Why this is not a React island ───────────────────────────────────────
 * It was one, at `client:idle`, and it cost the home route react-dom: 53KB
 * on the wire and a 73ms long task in the load window, to add two attributes
 * and one `scale` to markup the server had already rendered. Worse, the rail
 * is `hidden lg:flex` — it does not exist below 64rem — so every phone paid
 * the whole bill for a component it could not see, which is exactly what
 * §24.2 exists to prevent.
 *
 * The same reasoning retired the MobileNav island in Phase 7. React earns
 * its place in this project once, for the scene, where the reconciler is
 * doing real work; it does not earn it for a list of anchors.
 *
 * Reads scroll from the shared singleton rather than adding a listener
 * (§19.2b), and never touches layout: attribute writes happen only when the
 * active section actually changes.
 *
 * ── The axis is also a control ───────────────────────────────────────────
 * The hairline carries a playhead you can grab, so the rail is a seek bar
 * for the whole flight as well as an indicator of it — see
 * lib/beatScrubber.ts, which moves the SCROLL rather than the camera so
 * every other consumer follows for free.
 *
 * The progress fill and the playhead position are pure CSS, read from the
 * `--scroll` custom property the scroll loop already publishes to `<body>`.
 * That used to be a JS write on every frame; it does not need to be one.
 */
import { BANDS } from '../../lib/bands';

const LABELS: Record<string, string> = {
	'first-light': 'Home',
	log: 'About',
	atlas: 'Skills',
	trajectory: 'Experience',
	worlds: 'Projects',
	instruments: 'Lab',
	transmissions: 'Writing',
	uplink: 'Contact',
};
---

<nav
	aria-label="Sections"
	data-section-rail
	class="rail group/rail fixed inset-e-0 top-1/2 z-(--z-rail) hidden -translate-y-1/2 items-center gap-3 pe-4 lg:flex"
>
	<ul class="order-1 m-0 grid list-none gap-1 p-0 text-end">
		{
			BANDS.map((band, index) => (
				<li>
					<a
						href={`#${band.section}`}
						data-rail-tick
						aria-current={index === 0 ? 'true' : undefined}
						data-active={index === 0 ? true : undefined}
						class="group/tick flex min-h-5.5 items-center justify-end gap-2 px-1 text-ink-low no-underline transition-colors duration-(--duration-base) ease-ui hover:text-ink-hi data-active:text-accent"
					>
						<span
							aria-hidden="true"
							class="block h-px w-2 bg-current transition-[width,box-shadow] duration-(--duration-base) ease-ui group-data-active/tick:w-4 group-data-active/tick:shadow-glow-1"
						/>
						<span
							class="font-mono text-[0.625rem] tracking-[0.14em] uppercase opacity-0 transition-opacity duration-(--duration-fast) ease-ui group-hover/rail:opacity-100 group-focus-within/rail:opacity-100 group-data-scrubbing/rail:opacity-100 group-data-active/tick:opacity-100 2xl:opacity-100"
						>
							{LABELS[band.section]}
						</span>
					</a>
				</li>
			))
		}
	</ul>

	{/*
	  Axis and scrubber. A hairline that fills top-to-bottom with scroll
	  progress, plus a playhead you can drag to fly.

	  The track is 44px wide and invisible so the grab target meets §25.1
	  while the drawn line stays a hairline. `touch-none` because a vertical
	  drag here is the gesture, not a page scroll.
	*/}
	<div
		data-rail-track
		role="slider"
		tabindex="0"
		aria-label="Flight position"
		aria-orientation="vertical"
		aria-valuemin="0"
		aria-valuemax={BANDS.length - 1}
		aria-valuenow="0"
		aria-valuetext={`${LABELS[BANDS[0].section]} — beat 1 of ${BANDS.length}`}
		class="group/track relative order-2 flex h-44 w-11 cursor-grab touch-none items-stretch justify-center data-scrubbing:cursor-grabbing"
	>
		<div aria-hidden="true" class="relative w-px bg-hairline">
			<div
				data-rail-fill
				style="scale: 1 var(--scroll, 0)"
				class="absolute inset-0 origin-top bg-linear-to-b from-transparent to-accent"
			>
			</div>
		</div>

		{/* The playhead. Position is CSS from --scroll: no JS per frame. */}
		<div
			data-rail-knob
			aria-hidden="true"
			class="pointer-events-none absolute start-1/2 top-[calc(var(--scroll,0)*100%)] size-2 -translate-x-1/2 -translate-y-1/2 rotate-45 border border-accent bg-void shadow-glow-1 transition-[width,height] duration-(--duration-fast) ease-ui group-hover/track:size-2.5 group-focus-visible/track:size-2.5 group-data-scrubbing/track:size-2.5"
		>
		</div>
	</div>
</nav>

<script>
	import { scrollState, subscribe } from '../../lib/scrollProgress';
	import { initBeatScrubber } from '../../lib/beatScrubber';

	const rail = document.querySelector('[data-section-rail]');
	const ticks = rail ? [...rail.querySelectorAll<HTMLElement>('[data-rail-tick]')] : [];

	/*
	 * The rail is `hidden lg:flex`. Below that it is not rendered, so there is
	 * nothing to keep in sync and no reason to hold a scroll subscription.
	 */
	const wide = window.matchMedia('(min-width: 64rem)');

	let unsubscribe: (() => void) | null = null;

	function attach() {
		if (unsubscribe || ticks.length === 0) return;
		let lastIndex = -1;
		unsubscribe = subscribe(() => {
			// The fill and the playhead are CSS, driven by --scroll. All this
			// has to do is move `aria-current`, and only when it changes.
			if (scrollState.bandIndex === lastIndex) return;
			lastIndex = scrollState.bandIndex;
			ticks.forEach((tick, index) => {
				const active = index === lastIndex;
				tick.toggleAttribute('data-active', active);
				if (active) tick.setAttribute('aria-current', 'true');
				else tick.removeAttribute('aria-current');
			});
		});
	}

	function detach() {
		unsubscribe?.();
		unsubscribe = null;
	}

	function sync() {
		if (wide.matches) attach();
		else detach();
	}

	sync();
	wide.addEventListener('change', sync);

	/*
	 * The scrubber attaches once, not per breakpoint: the rail is
	 * `hidden lg:flex`, so below 64rem there is nothing to grab and nothing
	 * focusable, and re-attaching on every media change would leak
	 * listeners for no gain.
	 */
	initBeatScrubber();
</script>
