---
/**
 * One inline SVG sprite for the whole site (§29). Replaces the previous site's
 * Material Symbols webfont, which cost ~100KB+ for ~20 glyphs.
 * 24px grid, 1.5px stroke, geometric, no filled pictograms (§3.3).
 * Rendered once in BaseLayout; referenced via <Icon name="…" />.
 */
---

<svg
	aria-hidden="true"
	style="position:absolute;width:0;height:0;overflow:hidden"
	xmlns="http://www.w3.org/2000/svg"
>
	<defs>
		<g id="i-arrow-up-right"><path d="M7 17 17 7M17 7H9m8 0v8" /></g>
		<g id="i-arrow-right"><path d="M4 12h16m0 0-6-6m6 6-6 6" /></g>
		<g id="i-arrow-down"><path d="M12 4v16m0 0 6-6m-6 6-6-6" /></g>
		<g id="i-copy">
			<rect x="9" y="9" width="11" height="11" rx="2" />
			<path d="M15 6V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h1" />
		</g>
		<g id="i-check"><path d="m4 12 5 5L20 6" /></g>
		<g id="i-mail">
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<path d="m3.5 7 8.5 6 8.5-6" />
		</g>
		<g id="i-home"><path d="M4 11 12 4l8 7v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z" /></g>
		<g id="i-atlas">
			<path d="m12 3 2.2 4.9 5.3.6-4 3.6 1.1 5.2L12 14.7l-4.6 2.6 1.1-5.2-4-3.6 5.3-.6z" />
		</g>
		<g id="i-trajectory">
			<circle cx="12" cy="12" r="3" />
			<ellipse cx="12" cy="12" rx="9" ry="4.5" transform="rotate(-25 12 12)" />
		</g>
		<g id="i-worlds">
			<circle cx="12" cy="12" r="7.5" />
			<path d="M4.9 9h14.2M4.9 15h14.2M12 4.5c-2.2 2-3.4 4.7-3.4 7.5s1.2 5.5 3.4 7.5c2.2-2 3.4-4.7 3.4-7.5S14.2 6.5 12 4.5" />
		</g>
		<g id="i-instruments">
			<path d="M9 3v5.2L4.6 17A2 2 0 0 0 6.4 20h11.2a2 2 0 0 0 1.8-3L15 8.2V3" />
			<path d="M8 3h8M7.5 14h9" />
		</g>
		<g id="i-transmissions">
			<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5z" />
			<path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5z" />
		</g>
		<g id="i-more"><circle cx="5" cy="12" r="1.4" /><circle cx="12" cy="12" r="1.4" /><circle cx="19" cy="12" r="1.4" /></g>
		<g id="i-github">
			<path
				d="M9 19c-4 1.4-4-2.1-5.6-2.6m11.2 5.6v-3.9a3.4 3.4 0 0 0-.9-2.6c3.1-.3 5.3-1.5 5.3-6a4.7 4.7 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.3s-1.4-.4-4.6 1.7a11.5 11.5 0 0 0-5.9 0C3.9 2.6 2.5 3 2.5 3a4.3 4.3 0 0 0-.1 3.3A4.7 4.7 0 0 0 1.1 9.6c0 4.4 2.2 5.6 5.3 6a3.4 3.4 0 0 0-.9 2.6V22"
				transform="translate(2.4 1)"
			/>
		</g>
		<g id="i-linkedin">
			<rect x="3" y="3" width="18" height="18" rx="2" />
			<path d="M7.5 10.5V17M7.5 7.2v.1M11.5 17v-3.6a2.1 2.1 0 0 1 4.2 0V17" />
		</g>
		<g id="i-devto">
			<rect x="2" y="4.5" width="20" height="15" rx="2" />
			<path d="M6 9v6h1.4a1.6 1.6 0 0 0 1.6-1.6v-2.8A1.6 1.6 0 0 0 7.4 9zm6.6 0 1.3 6 1.3-6" />
