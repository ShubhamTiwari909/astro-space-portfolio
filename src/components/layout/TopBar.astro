---
/**
 * Fixed 64px bar (§7.2). Wordmark left, résumé right — and nothing else,
 * ever. It never grows. The résumé lives here so it stays at most one interaction
 * from every route at any scroll position (§6.1).
 */
import Button from '../ui/Button.astro';

interface Props {
	name: string;
	resumePdf: string;
}

const { name, resumePdf }: Props = Astro.props;
---

<header
	class="fixed inset-x-0 top-0 z-[var(--z-nav)] flex h-[var(--nav-h)] items-center justify-between gap-4 border-b border-hairline bg-void/72 px-[var(--gutter)] backdrop-blur-md"
>
	<a
		href="/"
		class="font-mono text-label tracking-[0.14em] text-ink-hi uppercase no-underline"
	>
		{name}
	</a>
	<Button
		variant="secondary"
		href={resumePdf}
		icon="arrow-down"
		download
		class="min-h-9 !px-3.5"
		data-analytics="dossier_download"
		data-analytics-location="topbar"
	>
		Dossier
	</Button>
</header>
