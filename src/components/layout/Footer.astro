---
/**
 * §15.4. The build stamp is a small honest engineering signal that costs
 * nothing — and it is computed at build, so it is never stale.
 */
import type { CollectionEntry } from 'astro:content';
import Icon, { type IconName } from '../ui/Icon.astro';

interface Props {
	profile: CollectionEntry<'profile'>['data'];
}

const { profile }: Props = Astro.props;
const buildStamp = new Date().toISOString().slice(0, 10);

const monoLabel = 'font-mono text-label tracking-[0.14em] uppercase';
---

<footer
	class="relative z-(--z-content) border-t border-hairline px-(--gutter) py-12"
>
	<div
		class="mx-auto grid max-w-content gap-4 md:grid-cols-[1fr_auto] md:items-center"
	>
		<p class={`m-0 text-ink-hi ${monoLabel}`}>{profile.name}</p>

		<p class="m-0 text-data text-ink-mid">
			© {new Date().getFullYear()} {profile.name} · Crafted with precision.
		</p>

		<ul
			class="m-0 flex list-none flex-wrap gap-5 p-0 md:col-start-2 md:row-start-1 md:justify-end"
		>
			{
				profile.socials.map((social) => (
					<li>
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							class={`inline-flex min-h-11 items-center gap-1.5 text-ink-mid no-underline transition-colors duration-(--duration-fast) ease-ui hover:text-accent ${monoLabel}`}
						>
							<Icon name={social.network as IconName} size={16} />
							<span>{social.label}</span>
							<span class="sr-only">(opens in a new tab)</span>
						</a>
					</li>
				))
			}
		</ul>

		<p
			class={`m-0 text-ink-low md:col-start-2 md:row-start-2 md:text-right ${monoLabel}`}
		>
			Build {buildStamp} · Astro
		</p>
	</div>
</footer>
