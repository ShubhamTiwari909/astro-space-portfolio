---
/**
 * §15.4. The build stamp is a small honest engineering signal that costs
 * nothing — and it is computed at build, so it is never stale.
 */
import type { CollectionEntry } from 'astro:content';
import Icon, { type IconName } from '../ui/Icon.astro';

interface Props {
	profile: CollectionEntry<'profile'>['data'];
}

const { profile }: Props = Astro.props;

const buildStamp = new Date().toISOString().slice(0, 10);
---

<footer class="footer">
	<div class="footer__inner">
		<p class="footer__mark">{profile.name}</p>
		<p class="footer__legal">
			© {new Date().getFullYear()} {profile.name} · Crafted with precision.
		</p>
		<ul class="footer__socials">
			{
				profile.socials.map((social) => (
					<li>
						<a href={social.url} target="_blank" rel="noopener noreferrer">
							<Icon name={social.network as IconName} size={16} />
							<span>{social.label}</span>
							<span class="sr-only">(opens in a new tab)</span>
						</a>
					</li>
				))
			}
		</ul>
		<p class="footer__build">Build {buildStamp} · Astro</p>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		z-index: var(--z-content);
		border-top: 1px solid var(--color-hairline);
		padding-block: 3rem;
		padding-inline: var(--gutter);
	}

	.footer__inner {
		max-width: var(--container-content);
		margin-inline: auto;
		display: grid;
		gap: 1rem;
	}

	.footer__mark,
	.footer__build {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin: 0;
	}

	.footer__mark {
		color: var(--color-ink-hi);
	}

	.footer__build {
		color: var(--color-ink-low);
	}

	.footer__legal {
		font-size: var(--text-data);
		color: var(--color-ink-mid);
		margin: 0;
	}

	.footer__socials {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer__socials a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 2.75rem;
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-ink-mid);
		text-decoration: none;
		transition: color var(--duration-fast) var(--ease-ui);
	}

	@media (hover: hover) and (pointer: fine) {
		.footer__socials a:hover {
			color: var(--color-ion);
		}
	}

	@media (width >= 48rem) {
		.footer__inner {
			grid-template-columns: 1fr auto;
			align-items: center;
		}

		.footer__socials {
			grid-column: 2;
			grid-row: 1;
			justify-content: flex-end;
		}

		.footer__build {
			grid-column: 2;
			grid-row: 2;
			text-align: right;
		}
	}
</style>
