---
/**
 * Status is ALWAYS conveyed by text alongside the dot — never colour alone
 * (§25.1 colour independence). The dot is decorative reinforcement.
 */
interface Props {
	status: 'LIVE' | 'ARCHIVED' | 'PRIVATE' | 'OPEN' | 'CLOSED';
	label?: string;
	class?: string;
}
const { status, label, class: className = '' }: Props = Astro.props;
const active = status === 'LIVE' || status === 'OPEN';
---

<span
	data-active={active || undefined}
	class:list={[
		'inline-flex items-center gap-2 font-mono text-label tracking-[0.14em] uppercase',
		active ? 'text-accent' : 'text-ink-low',
		className,
	]}
>
	<span
		aria-hidden="true"
		class:list={[
			'size-1.5 rounded-pill bg-current',
			active && 'shadow-glow-1 pulse-glow',
		]}
	></span>
	<span>{label ?? status}</span>
</span>
