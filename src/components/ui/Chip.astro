---
/**
 * Non-interactive label (§17.4). Chips deliberately have no hover state —
 * they are data, not controls.
 */
interface Props {
	class?: string;
}
const { class: className = '' }: Props = Astro.props;
---

<span
	class:list={[
		'inline-block whitespace-nowrap rounded-chip border border-hairline px-2 py-1 font-mono text-[0.6875rem] tracking-[0.08em] text-ink-mid uppercase',
		className,
	]}
>
	<slot />
</span>
