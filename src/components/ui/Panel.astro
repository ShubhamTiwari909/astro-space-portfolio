---
/**
 * Instrument panel (§17.2). Glass readout over the backdrop: translucent
 * surface, hairline border, corner ticks.
 *
 * Over a live 3D scene the blur does real work — it separates the console
 * from the vastness behind it, and it is the main thing keeping text legible
 * against a moving backdrop. Below `md` it becomes opaque, because
 * backdrop-filter over a WebGL canvas is the most expensive thing on a
 * mobile GPU (§24.2).
 */
interface Props {
	variant?: 'subtle' | 'standard' | 'strong';
	as?: 'div' | 'article' | 'section' | 'li' | 'aside';
	ticks?: boolean;
	class?: string;
}

const {
	variant = 'standard',
	as: Tag = 'div',
	ticks = true,
	class: className = '',
}: Props = Astro.props;

/** Tick intensity per §17.2, expressed as the utility's own variables. */
const tickVars = {
	subtle: '--tick-color: var(--color-hairline); --tick-size: 6px;',
	standard: '--tick-color: var(--color-hairline-hi); --tick-size: 8px;',
	strong:
		'--tick-color: color-mix(in oklab, var(--band) 45%, transparent); --tick-size: 12px;',
}[variant];
---

<Tag
	class:list={[
		'rounded-panel border border-hairline bg-surface-1/72 shadow-panel backdrop-blur-md md:bg-surface-1/72 max-md:bg-surface-1 max-md:backdrop-blur-none',
		ticks && 'ticks',
		className,
	]}
	style={ticks ? tickVars : undefined}
>
	<slot />
</Tag>
