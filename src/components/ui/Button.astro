---
/**
 * All six visual states are defined (§17.4): default, hover, focus-visible,
 * active, disabled, loading. A missing state is a bug.
 *
 * Renders <a> or <button> per `as` — never a div with a handler (§25.1).
 * Hover styles are guarded by (hover: hover) so touch devices never get
 * stuck hover states (§24.3).
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
	variant?: 'primary' | 'secondary' | 'ghost';
	as?: 'a' | 'button';
	href?: string;
	type?: 'button' | 'submit';
	icon?: IconName;
	iconPosition?: 'start' | 'end';
	external?: boolean;
	download?: boolean;
	disabled?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	variant = 'primary',
	as: Tag = 'a',
	href,
	type,
	icon,
	iconPosition = 'end',
	external = false,
	download = false,
	disabled = false,
	class: className = '',
	...rest
}: Props = Astro.props;

const externalAttrs = external
	? { target: '_blank', rel: 'noopener noreferrer' }
	: {};
---

<Tag
	class:list={['btn', `btn--${variant}`, className]}
	href={Tag === 'a' ? href : undefined}
	type={Tag === 'button' ? (type ?? 'button') : undefined}
	download={download ? '' : undefined}
	aria-disabled={disabled ? 'true' : undefined}
	{...externalAttrs}
	{...rest}
>
	{icon && iconPosition === 'start' && <Icon name={icon} size={16} />}
	<span><slot /></span>
	{icon && iconPosition === 'end' && <Icon name={icon} size={16} />}
	{external && <span class="sr-only">(opens in a new tab)</span>}
</Tag>

<style>
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 2.75rem; /* 44px touch target (§24.3) */
		padding-inline: 1.25rem;
		border-radius: var(--radius-card);
		border: 1px solid transparent;
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color var(--duration-fast) var(--ease-ui),
			border-color var(--duration-fast) var(--ease-ui),
			box-shadow var(--duration-fast) var(--ease-ui),
			transform var(--duration-fast) var(--ease-ui),
			color var(--duration-fast) var(--ease-ui);
	}

	/* ---- primary ---- */
	.btn--primary {
		background-color: var(--color-surface-2);
		border-color: color-mix(in oklab, var(--color-ion) 40%, transparent);
		color: var(--color-ion);
		box-shadow: var(--shadow-glow-1);
	}

	@media (hover: hover) and (pointer: fine) {
		.btn--primary:hover {
			border-color: color-mix(in oklab, var(--color-ion) 70%, transparent);
			box-shadow: var(--shadow-glow-2);
			transform: translateY(-1px);
		}
	}

	.btn--primary:active {
		transform: translateY(0);
		box-shadow: var(--shadow-glow-1);
	}

	/* ---- secondary ---- */
	.btn--secondary {
		background-color: transparent;
		border-color: var(--color-hairline-hi);
		color: var(--color-ink-hi);
	}

	@media (hover: hover) and (pointer: fine) {
		.btn--secondary:hover {
			background-color: var(--color-surface-1);
			border-color: color-mix(in oklab, var(--color-ion) 45%, transparent);
		}
	}

	/* ---- ghost ---- */
	.btn--ghost {
		background-color: transparent;
		color: var(--color-ink-mid);
		padding-inline: 0.5rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.btn--ghost:hover {
			color: var(--color-ink-hi);
		}
	}

	/* ---- disabled / loading ---- */
	.btn[aria-disabled='true'] {
		opacity: 0.45;
		pointer-events: none;
		box-shadow: none;
	}

	.btn[data-loading] {
		pointer-events: none;
		color: var(--color-ink-low);
	}
</style>
