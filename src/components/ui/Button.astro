---
/**
 * All six visual states are defined (§17.4): default, hover, focus-visible,
 * active, disabled, loading. A missing state is a bug.
 *
 * Renders <a> or <button> per `as` — never a div with a handler (§25.1).
 * Hover styles are guarded by hover:hover so touch devices never get stuck
 * hover states (§24.3) — Tailwind's `hover:` already compiles to that.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
	variant?: 'primary' | 'secondary' | 'ghost';
	as?: 'a' | 'button';
	href?: string;
	type?: 'button' | 'submit';
	icon?: IconName;
	iconPosition?: 'start' | 'end';
	external?: boolean;
	download?: boolean;
	disabled?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	variant = 'primary',
	as: Tag = 'a',
	href,
	type,
	icon,
	iconPosition = 'end',
	external = false,
	download = false,
	disabled = false,
	class: className = '',
	...rest
}: Props = Astro.props;

const base =
	'inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-card border font-mono text-label tracking-[0.14em] uppercase no-underline transition-[background-color,border-color,box-shadow,transform,color] duration-[var(--duration-fast)] ease-ui aria-disabled:pointer-events-none aria-disabled:opacity-45 aria-disabled:shadow-none data-loading:pointer-events-none data-loading:text-ink-low';

const variants = {
	primary:
		'bg-surface-2 border-accent/40 text-accent shadow-glow-1 px-5 hover:border-accent/70 hover:shadow-glow-2 hover:-translate-y-px active:translate-y-0 active:shadow-glow-1',
	secondary:
		'bg-transparent border-accent/35 text-ink-hi px-5 hover:bg-surface-1 hover:border-accent/60',
	ghost: 'border-transparent bg-transparent text-ink-mid px-2 hover:text-ink-hi',
};

const externalAttrs = external
	? { target: '_blank', rel: 'noopener noreferrer' }
	: {};
---

<Tag
	class:list={[base, variants[variant], className]}
	href={Tag === 'a' ? href : undefined}
	type={Tag === 'button' ? (type ?? 'button') : undefined}
	download={download ? '' : undefined}
	aria-disabled={disabled ? 'true' : undefined}
	{...externalAttrs}
	{...rest}
>
	{icon && iconPosition === 'start' && <Icon name={icon} size={16} />}
	<span><slot /></span>
	{icon && iconPosition === 'end' && <Icon name={icon} size={16} />}
	{external && <span class="sr-only">(opens in a new tab)</span>}
</Tag>
