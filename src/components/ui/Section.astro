---
/**
 * The section contract (§8.1). Every home-route section uses this — never
 * hand-roll the anatomy.
 *
 *   eyebrow   CODENAME · {real data readout}
 *   h2        Plain Name
 *   lede      one sentence (optional)
 *   body      slot
 *
 * Height is decided by content: no 100vh sections (mobile URL-bar jump,
 * clipped content). `data-observe` is the hook the single shared
 * IntersectionObserver uses for entrance animation.
 */
interface Props {
	id: string;
	codename: string;
	/** Real telemetry only — counts, coordinates, ranges. Never fabricated (§8.1). */
	readout?: string;
	title: string;
	lede?: string;
	/**
	 * The section title's heading level.
	 *
	 * `h2` on the one-page survey, where the Hero owns the `h1`. But on a
	 * sub-route the section *is* the page, and those shipped with no `h1` at
	 * all — an `h2` as the first heading, which is a broken outline for
	 * anyone navigating by headings.
	 */
	as?: 'h1' | 'h2';
	class?: string;
}

const {
	id,
	codename,
	readout,
	title,
	lede,
	as: Heading = 'h2',
	class: className = '',
}: Props = Astro.props;
---

<section
	id={id}
	class:list={[
		'relative z-(--z-content) px-(--gutter) py-(--section-y)',
		className,
	]}
>
	<div class="mx-auto max-w-content">
		<p
			data-observe
			class="mb-4 font-mono text-label tracking-[0.14em] text-ink-low uppercase"
		>
			<span>{codename}</span>
			{readout && <span> · {readout}</span>}
		</p>
		<Heading data-observe class="mb-4 text-display-l">{title}</Heading>
		{
			lede && (
				<p
					data-observe
					class="mb-12 max-w-(--prose) text-body-l text-ink-mid"
				>
					{lede}
				</p>
			)
		}
		<div class="mt-8">
			<slot />
		</div>
	</div>
</section>
