---
/**
 * The section contract (§8.1). Every home-route section uses this — never
 * hand-roll the anatomy.
 *
 *   eyebrow   CODENAME · {real data readout}
 *   h2        Plain Name
 *   lede      one sentence (optional)
 *   body      slot
 *
 * Height is decided by content: no 100vh sections (mobile URL-bar jump,
 * clipped content). `data-observe` is the hook the single shared
 * IntersectionObserver uses for entrance animation.
 */
interface Props {
	id: string;
	codename: string;
	/** Real telemetry only — counts, coordinates, ranges. Never fabricated (§8.1). */
	readout?: string;
	title: string;
	lede?: string;
	class?: string;
}

const { id, codename, readout, title, lede, class: className = '' }: Props =
	Astro.props;
---

<section
	id={id}
	class:list={[
		'relative z-[var(--z-content)] px-[var(--gutter)] py-[var(--section-y)]',
		className,
	]}
>
	<div class="mx-auto max-w-content">
		<p
			data-observe
			class="mb-4 font-mono text-label tracking-[0.14em] text-ink-low uppercase"
		>
			<span>{codename}</span>
			{readout && <span class="opacity-80"> · {readout}</span>}
		</p>
		<h2 data-observe class="mb-4 text-display-l">{title}</h2>
		{
			lede && (
				<p
					data-observe
					class="mb-12 max-w-[var(--prose)] text-body-l text-ink-mid"
				>
					{lede}
				</p>
			)
		}
		<div class="mt-8">
			<slot />
		</div>
	</div>
</section>
