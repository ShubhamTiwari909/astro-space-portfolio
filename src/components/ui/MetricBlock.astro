---
/**
 * A number is never orphaned from its meaning (§12.5): the value and label
 * are one sentence to a screen reader, and the basis line sits with them so
 * the claim survives scrutiny (§12.2).
 */
interface Props {
	value: string;
	label: string;
	basis?: string;
	class?: string;
}
const { value, label, basis, class: className = '' }: Props = Astro.props;
---

<p class:list={['m-0 grid gap-1', className]}>
	<strong
		class="font-mono text-display-l leading-none font-medium text-accent"
	>
		{value}
	</strong>
	<span class="font-mono text-label tracking-[0.14em] text-ink-mid uppercase">
		{label}
	</span>
	{
		basis && (
			<span class="font-mono text-[0.6875rem] tracking-[0.04em] text-ink-low">
				{basis}
			</span>
		)
	}
</p>
