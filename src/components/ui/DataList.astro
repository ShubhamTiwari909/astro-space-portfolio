---
/**
 * Real <dl> for label/value data (§25.1). The "instrument metadata panel"
 * look comes from the mono labels and hairline rows, not from a table.
 */
interface Props {
	items: Array<{ label: string; value: string }>;
	class?: string;
}
const { items, class: className = '' }: Props = Astro.props;
---

<dl class:list={['grid gap-0', className]}>
	{
		items.map((item, i) => (
			<div
				class:list={[
					'grid gap-1 py-2.5 xs:grid-cols-[minmax(6rem,9rem)_1fr] xs:gap-4',
					i < items.length - 1 && 'border-b border-hairline',
				]}
			>
				<dt class="font-mono text-label tracking-[0.14em] text-ink-low uppercase">
					{item.label}
				</dt>
				<dd class="m-0 text-data text-ink-hi">{item.value}</dd>
			</div>
		))
	}
</dl>
