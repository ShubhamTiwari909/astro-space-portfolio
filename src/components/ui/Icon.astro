---
/**
 * Sprite reference. Icons are always decorative here — every icon in this
 * design sits beside a real text label (§25.1), so `aria-hidden` is the
 * correct default and there is no `label` prop to misuse.
 */
export type IconName =
	| 'arrow-up-right'
	| 'arrow-right'
	| 'arrow-down'
	| 'copy'
	| 'check'
	| 'mail'
	| 'home'
	| 'atlas'
	| 'trajectory'
	| 'worlds'
	| 'instruments'
	| 'transmissions'
	| 'more'
	| 'github'
	| 'linkedin'
	| 'devto'
	| 'instagram';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 20, class: className = '' }: Props = Astro.props;
---

<svg
	aria-hidden="true"
	focusable="false"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
>
	<use href={`#i-${name}`}></use>
</svg>
