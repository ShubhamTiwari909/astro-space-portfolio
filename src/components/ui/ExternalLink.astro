---
/**
 * External links always carry a visually-hidden new-tab warning (§25.1) and
 * rel="noopener noreferrer". The arrow is decorative.
 */
import Icon from './Icon.astro';

interface Props {
	href: string;
	arrow?: boolean;
	class?: string;
}
const { href, arrow = true, class: className = '' }: Props = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[
		'inline-flex items-center gap-1 text-accent underline decoration-accent/40 underline-offset-4 transition-colors duration-[var(--duration-fast)] ease-ui hover:decoration-accent',
		className,
	]}
>
	<slot />
	{arrow && <Icon name="arrow-up-right" size={14} />}
	<span class="sr-only">(opens in a new tab)</span>
</a>
