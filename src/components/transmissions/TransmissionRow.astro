---
/**
 * One transmission — master plan §8.2.
 *
 * A hairline-ruled row, not a card: a list reads faster than a grid and
 * costs nothing to render. The whole row is the link target, so middle-click
 * and cmd-click behave natively.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';

interface Props {
	/** `h3` in the home-route feed under a Section h2; `h2` on the full
	    route, where the Section title is the page h1. */
	as?: 'h2' | 'h3';
	article: CollectionEntry<'articles'>['data'];
	slug: string;
}

const { article, slug, as: Heading = 'h3' }: Props = Astro.props;

const date = new Date(article.publishedAt);
const stamp = date
	.toLocaleDateString('en-GB', {
		day: '2-digit',
		month: 'short',
		year: 'numeric',
	})
	.toUpperCase();
---

<li class="border-b border-hairline last:border-b-0">
	<a
		href={article.url}
		target="_blank"
		rel="noopener noreferrer"
		data-analytics="transmission_click"
		data-analytics-slug={slug}
		aria-label={article.title}
		class="px-5 group/row grid min-h-22 grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 rounded-card border border-transparent py-4 no-underline transition-[background-color,padding-inline-start,border-color,backdrop-filter] duration-(--duration-fast) ease-ui hover:border-hairline hover:bg-surface-1/70 hover:ps-4 hover:backdrop-blur-sm md:grid-cols-[6rem_1fr_auto] md:gap-x-6"
	>
		<time
			datetime={article.publishedAt}
			class="font-mono text-[0.625rem] tracking-[0.08em] text-ink-low tabular-nums max-md:col-span-2"
		>
			{stamp}
		</time>

		<div class="min-w-0 max-md:col-span-2">
			<Heading
				class="text-display-s text-ink-mid transition-colors duration-(--duration-fast) ease-ui group-hover/row:text-ink-hi"
			>
				{article.title}
			</Heading>
			{
				article.excerpt && (
					<p class="mt-1 mb-0 line-clamp-2 text-data text-ink-low">
						{article.excerpt}
					</p>
				)
			}
		</div>

		<span
			class="justify-self-end text-accent transition-transform duration-(--duration-fast) ease-ui group-hover/row:-translate-y-0.5 group-hover/row:translate-x-0.5 max-md:row-start-1 max-md:self-start"
		>
			<Icon name="arrow-up-right" size={16} />
		</span>
		<span class="sr-only">(opens in a new tab)</span>
	</a>
</li>
