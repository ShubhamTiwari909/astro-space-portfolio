---
/**
 * The backdrop stack — §17.1. Mounted once in BaseLayout, fixed behind
 * everything, persisting across routes via transition:persist.
 *
 *   void   --z-void    body background
 *   art    --z-art     AI/procedural plates + LQIP  (always present)
 *   scene  --z-scene   RESERVED — the WebGL canvas claims this in Phase 4
 *   grain  --z-grain   noise tile, unifies art and render
 *
 * The scene layer is deliberately left empty rather than absent, so Phase 4
 * needs no re-stacking.
 */
import { getCollection } from 'astro:content';
import ArtBackdrop from './ArtBackdrop.astro';
import Grain from './Grain.astro';
import DeepFieldScene from './scene/DeepFieldScene';
import { plateHueForIndex } from '../../data/seed';

interface Props {
	/**
	 * Whether to mount the WebGL scene on top of the art layer.
	 *
	 * §26.2 states that `/transmissions` and `/dossier` "deliberately do
	 * not mount the scene — they are reading routes". That was never
	 * implemented: measured, both were fetching the 226KB scene chunk
	 * against 16KB and 20KB JS budgets, 1858% and 1486% over. The art
	 * layer still renders on those routes, because it is the designed
	 * backdrop in its own right and costs ~34KB of images that are already
	 * in their budget.
	 */
	scene?: boolean;
}

const { scene = true }: Props = Astro.props;

/*
 * The scene's data comes from the same collections the DOM renders, so a
 * planet cannot exist without a project card — which is what keeps the
 * §25.0 parallel-DOM table true by construction.
 *
 * Hue uses plateHueForIndex, the same function the CSS fallback sphere uses,
 * so the 3D planet and its DOM counterpart are the same colour by
 * construction rather than by coincidence.
 */
const [projects, experience] = await Promise.all([
	getCollection('projects'),
	getCollection('experience'),
]);

const planets = [...projects]
	.sort((a, b) => a.data.order - b.data.order)
	.map((project, i) => ({
		slug: project.data.slug,
		hue: plateHueForIndex(i),
		featured: project.data.featured,
		order: project.data.order,
	}));

const burnEvents = experience.reduce(
	(sum, entry) => sum + entry.data.achievements.length,
	0,
);
---

<ArtBackdrop />

{/*
  The scene claims --z-scene, between the art and the grain.
  `client:capable` is `client:idle` plus §24.2's bail-out moved in FRONT of
  the download: it never competes with LCP, and a visitor with no WebGL or
  `saveData` set never fetches the 227KB chunk at all — which is what
  useSceneTier already claimed happened (§9.3, §20.2).

  Omitted entirely on the reading routes (§26.2). Not hidden, not deferred
  — absent, so the chunk is never requested.
*/}
{scene && <DeepFieldScene client:capable planets={planets} burnEvents={burnEvents} />}

<Grain />
