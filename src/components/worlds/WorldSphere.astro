---
/**
 * A world — master plan §10.2, §10.6.
 *
 * Pure CSS: a radial-gradient sphere with limb lighting and a terminator,
 * hue seeded deterministically from the slug so each project has a stable,
 * distinct identity. Zero image bytes, infinitely scalable.
 *
 * This is the Phase 3 representation and remains the fallback in every
 * degraded state once Phase 4b adds the real 3D planets. It is decorative:
 * the project is always identified by its text name and designation, and the
 * hue conveys nothing (§10.6).
 */
import { plateHue } from '../../data/seed';

interface Props {
	slug: string;
	/** Explicit hue wins over the slug hash — see plateHueForIndex. */
	hue?: number;
	size?: 'sm' | 'lg';
	ring?: boolean;
	class?: string;
}

const {
	slug,
	hue: hueProp,
	size = 'sm',
	ring = false,
	class: className = '',
}: Props = Astro.props;

const hue = hueProp ?? plateHue(slug);
---

<div
	aria-hidden="true"
	class:list={[
		'world-sphere relative shrink-0 rounded-pill',
		size === 'lg' ? 'size-28 md:size-40' : 'size-14',
		className,
	]}
	style={`--h: ${hue}`}
>
	{
		ring && (
			<span
				class="absolute left-1/2 top-1/2 -z-10 h-[18%] w-[165%] -translate-x-1/2 -translate-y-1/2 -rotate-[18deg] rounded-[50%] border border-[hsl(var(--h)_80%_78%/0.35)]"
			/>
		)
	}
</div>

<style>
	/*
	 * Three stacked gradients: a bright limb where the light hits, the body
	 * tone, and a terminator that falls off into shadow. Gradients rather
	 * than a border/shadow so it reads as a lit sphere, not a disc.
	 */
	.world-sphere {
		/* Glow radii scale with the sphere, so they are named rather than
		   inline magic numbers. */
		--limb-glow: 18px;
		--halo-glow: 32px;
		background-image:
			radial-gradient(
				circle at 30% 26%,
				hsl(var(--h) 92% 82% / 0.95) 0%,
				hsl(var(--h) 85% 62% / 0.85) 22%,
				hsl(var(--h) 70% 34% / 0.9) 52%,
				hsl(var(--h) 65% 12% / 0.95) 78%,
				hsl(var(--h) 60% 6%) 100%
			),
			radial-gradient(
				circle at 78% 82%,
				hsl(var(--h) 80% 55% / 0.35) 0%,
				transparent 55%
			);
		box-shadow:
			inset 0 0 var(--limb-glow) -6px hsl(var(--h) 90% 80% / 0.5),
			0 0 var(--halo-glow) -10px hsl(var(--h) 85% 60% / 0.45);
	}
</style>
