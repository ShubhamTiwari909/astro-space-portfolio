---
/**
 * Orbit's static fallback — master plan §14.3, Phase 5 task 8.
 *
 * This is what **most** visitors see, so it is treated as a designed
 * artefact rather than an apology: a real frame of the real simulation
 * (generated by `scripts/generate-orbit-poster.mjs`, which screenshots the
 * running sim), plus the same description the live version carries.
 *
 * Rendered below 1024px, where the island is never downloaded — so there is
 * deliberately no START button here. A control that cannot work is worse
 * than no control: the visitor at 800px has no simulation to start, and
 * offering one would be a dead end. The reduced-motion case *does* get a
 * button, but that lives inside the island, where it can actually run.
 */
import { Image } from 'astro:assets';
import poster from '../../assets/images/orbit-poster.avif';

interface Props {
	description: string;
	/** Stated plainly, so the absence reads as a decision, not a failure. */
	note?: string;
}

const { description, note }: Props = Astro.props;
---

<div class="grid gap-4">
	<Image
		src={poster}
		alt=""
		widths={[640, 900, 1200]}
		sizes="(width < 48rem) 100vw, 44rem"
		class="h-auto w-full rounded-card border border-hairline"
		loading="lazy"
		decoding="async"
	/>

	<p class="max-w-[var(--prose)] text-body text-ink-mid">{description}</p>

	{
		note && (
			<p class="font-mono text-data text-ink-low">{note}</p>
		)
	}
</div>
