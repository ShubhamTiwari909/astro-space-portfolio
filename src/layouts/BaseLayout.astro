---
/**
 * Master plan §21.2. Owns <head>, fonts, chrome, and the single <main id="main">.
 * The cosmos background layer arrives in Phase 2; nothing here hydrates.
 */
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import '../styles/global.css';
import IconSprite from '../components/layout/IconSprite.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import TopBar from '../components/layout/TopBar.astro';
import Footer from '../components/layout/Footer.astro';
import Cosmos from '../components/cosmos/Cosmos.astro';
import SectionRail from '../components/layout/SectionRail';
import MobileNav from '../components/layout/MobileNav.astro';

interface Props {
	title: string;
	description: string;
	/** Set false on /dev pages so they never reach production indexes. */
	indexable?: boolean;
	/** /dev pages opt out of the cosmos so tokens can be judged on their own. */
	backdrop?: boolean;
	/**
	 * Whether the WebGL scene mounts. The reading routes keep the art
	 * backdrop but not the 226KB scene chunk (§26.2).
	 */
	scene?: boolean;
	/** The rail only makes sense on the one-page survey. */
	rail?: boolean;
}

const {
	title,
	description,
	indexable = true,
	backdrop = true,
	scene = true,
	rail = false,
}: Props = Astro.props;

const profile = await getEntry('profile', 'shubham-tiwari');
if (!profile) throw new Error('profile collection entry "shubham-tiwari" is missing');

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{!indexable && <meta name="robots" content="noindex, nofollow" />}
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#04060D" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

		{/* Blocking + inline so the entrance state applies before first paint.
		    Without JS this never runs and [data-observe] stays visible (P1). */}
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		{/* Display + body preloaded; mono is not on the critical path (§26.3) */}
		<Font cssVariable="--ff-display" preload />
		<Font cssVariable="--ff-body" preload />
		<Font cssVariable="--ff-mono" />
	</head>

	<body>
		<IconSprite />
		{backdrop && <Cosmos scene={scene} transition:persist />}
		<SkipLink />
		<TopBar
			name={profile.data.name}
			resumePdf={profile.data.resumePdf}
		/>

		{rail && <SectionRail client:idle />}

		<main id="main">
			<slot />
		</main>

		<MobileNav />

		<Footer profile={profile.data} />

		{/*
		  Both of these are Astro scripts, not islands, and that distinction is
		  load-bearing: a `client:load` React island would drag react-dom
		  (~57KB gz) onto the critical path for code that renders nothing. As
		  plain modules they cost ~2KB gz combined, which is what keeps the
		  critical-path budget (§26.2) intact. React still loads — at idle,
		  for the nav islands that genuinely need it.
		*/}
		<script>
			import { init } from '../lib/scrollProgress';
			import { observeOnce } from '../lib/observeOnce';
			import { initWorldFocus } from '../lib/worldFocus';
			import { initAnalytics } from '../lib/analytics';

			let teardown = init();
			let teardownFocus = initWorldFocus();
			let teardownAnalytics = initAnalytics();
			observeOnce();

			// Re-arm after a View Transition swaps the document.
			document.addEventListener('astro:page-load', () => {
				teardown?.();
				teardownFocus?.();
				teardownAnalytics?.();
				teardown = init();
				teardownFocus = initWorldFocus();
				teardownAnalytics = initAnalytics();
				observeOnce();
			});
		</script>
	</body>
</html>
